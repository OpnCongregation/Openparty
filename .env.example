# Copy to .env and fill in. Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=change-me
MASTER_KEY_HEX=
# Optional key ring for rotation (see docs/key-management.md): MASTER_KEYS=k1:<hex>,k2:<hex> and MASTER_KEY_ACTIVE=k2.
# MASTER_KEY_HEX stays valid as key "k0", so existing data keeps opening.
MASTER_KEYS=
MASTER_KEY_ACTIVE=
# The master key is held in the platform's memory, which is not an HSM. The platform refuses to start in production
# unless you acknowledge that with 1. Leave 0 for a real deployment until a KMS/HSM KeyProvider is installed.
ALLOW_SOFTWARE_KEYS=0
PEPPER_HEX=
# Shared secret the USSD gateway sends (header x-ussd-secret or HTTP Basic password). 16+ characters. Required unless LAB_ENABLED=1.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
USSD_WEBHOOK_SECRET=
# Optional: comma-separated source addresses the gateway calls from. Set TRUST_PROXY=1 only behind a reverse proxy you control.
USSD_ALLOWED_IPS=
TRUST_PROXY=0
# Request limits per minute (shared through the database, so they hold across restarts and several instances). Defaults: 20 failed
# authentications per address, 30 requests per phone number, 6000 per gateway address. Leave empty for the defaults.
USSD_RATE_AUTHFAIL=
USSD_RATE_PER_PHONE=
USSD_RATE_PER_GATEWAY=
APPEND_TOKEN=change-me
# Filled in after the first start of the log (step 2 in README "Run with Docker"):
LOG_KEY=
# Rules lab (sandboxed scenarios; never touches real data). Set to 1 for demos, leave 0 otherwise:
LAB_ENABLED=0
# Log anchoring: "simulated" (default; a local note only) or "opentimestamps" (sends only the 32-byte head hash to public
# calendar servers, which anchor it in Bitcoin; free). Optional comma-separated OTS_CALENDARS overrides the defaults.
ANCHOR_MODE=simulated
